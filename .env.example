# Copy this file to .env and fill in the values.

# --- Provider API keys ---
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
IEEE_API_KEY=

# --- SSL verification ---
# Set to "false" on corporate networks where a proxy intercepts HTTPS traffic
# with a self-signed certificate and causes SSL: CERTIFICATE_VERIFY_FAILED errors.
# Leave unset or set to "true" to keep the secure default.
# HTTPX_VERIFY_SSL=false
