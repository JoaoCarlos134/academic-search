# Copy this file to .env and fill in the values.

# --- Provider API keys ---
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
IEEE_API_KEY=

# --- Semantic Scholar ---
# Optional. Without a key the anonymous tier is used (~1 req/sec).
# Get a key at https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# --- OpenAlex polite pool ---
# OpenAlex requires no key, but providing an email puts you in the "polite pool"
# with better rate limits. https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=

# --- SSL verification ---
# Set to "false" on corporate networks where a proxy intercepts HTTPS traffic
# with a self-signed certificate and causes SSL: CERTIFICATE_VERIFY_FAILED errors.
# Leave unset or set to "true" to keep the secure default.
# HTTPX_VERIFY_SSL=false
